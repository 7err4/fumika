{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fumika",
  "version": "0.1.1",
  "identifier": "com.fumika.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/clean-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=en-US",
        "title": "Fumika",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": false,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=en-US",
        "title": "Fumika",
        "url": "splash.html",
        "width": 540,
        "height": 300,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: comfyimg: http://comfyimg.localhost; connect-src 'self' ipc: http://ipc.localhost comfyimg: http://comfyimg.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/plugins/": "plugins/"
    },
    "publisher": "7err4",
    "copyright": "© 2026 7err4",
    "category": "GraphicsAndDesign",
    "shortDescription": "Comics, images and LoRAs with local AI models",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German",
          "French",
          "Italian",
          "Spanish",
          "SpanishInternational",
          "PortugueseBR",
          "Japanese",
          "Korean",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
