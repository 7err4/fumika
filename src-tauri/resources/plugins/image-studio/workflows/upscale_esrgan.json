   "source": "{{source}}",
   "width": 0,
   "height": 0,
   "scale": 1.0,
   "max_side": 4096
  }
 },
 "20": {
  "class_type": "UpscaleModelLoader",
  "inputs": {
   "model_name": "{{upscaler}}"
  }
 },
 "21": {
  "class_type": "ImageUpscaleWithModel",
  "inputs": {
   "upscale_model": [
    "20",
    0
   ],
   "image": [
    "10",
    0
   ]
  }
 },
 "22": {
  "class_type": "ImageScaleBy",
