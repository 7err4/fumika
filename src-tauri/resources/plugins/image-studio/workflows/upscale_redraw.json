{
 "1": {
  "class_type": "FumikaModelLoader",
  "inputs": {
   "loader": "{{loader}}",
   "unet": "{{unet}}",
   "text_encoder": "{{text_encoder}}",
   "vae": "{{vae}}",
   "clip_type": "{{clip_type}}",
   "clip_skip": "{{clip_skip}}"
  }
 },
 "4": {
  "class_type": "LoraLoaderModelOnly",
  "_when": "turbo_lora",
  "_bypass": "model",
  "inputs": {
   "model": [
    "1",
    0
   ],
   "lora_name": "{{turbo_lora ?? \"\"}}",
   "strength_model": 1.0
  }
 },
 "5": {
  "class_type": "FumikaLoraStack",
  "inputs": {
   "model": [
    "4",
    0
   ],
   "loras": "{{loras}}",
   "clip": [
    "1",
    1
   ],
   "clip_loras": "{{clip_loras}}"
  }
 },
 "6": {
  "class_type": "LoraLoaderModelOnly",
  "_when": "sft_look",
  "_bypass": "model",
  "inputs": {
   "model": [
    "5",
    0
   ],
   "lora_name": "{{sft_look ?? \"\"}}",
   "strength_model": "{{sft_strength}}"
  }
 },
 "7": {
  "class_type": "SkipLayerGuidanceDiTSimple",
  "_when": "slg",
  "_bypass": "model",
  "inputs": {
   "model": [
    "6",
    0
   ],
   "double_layers": "",
   "single_layers": "{{slg ?? \"\"}}",
   "start_percent": 0.0,
   "end_percent": 1.0
  }
 },
 "8": {
  "class_type": "FumikaPromptEncode",
  "inputs": {
   "clip": [
    "5",
    1
   ],
   "text": "{{prompt}}",
   "model": [
    "5",
    0
   ],
   "te2": "{{te2 ?? \"\"}}"
  }
 },
 "9": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "clip": [
    "5",
    1
   ],
   "text": "{{negative ?? \"\"}}"
  }
 },
 "10": {
  "class_type": "FumikaLoadSource",
  "inputs": {
   "source": "{{source}}",
   "width": 0,
   "height": 0,
   "scale": "{{scale}}",
   "max_side": 3072
  }
 },
 "14": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "10",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 },
 "11": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "7",
    0
   ],
   "positive": [
    "8",
    0
   ],
   "negative": [
    "9",
    0
   ],
   "latent_image": [
    "14",
    0
   ],
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "denoise": "{{denoise}}"
  }
 },
 "12": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "11",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 },
 "13": {
  "class_type": "SaveImage",
  "inputs": {
   "images": [
    "12",
    0
   ],
   "filename_prefix": "{{prefix}}"
  }
 }
}
