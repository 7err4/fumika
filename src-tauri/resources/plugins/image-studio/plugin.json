{
  "id": "image-studio",
  "name": "Image Studio",
  "version": "1.3.0",
  "author": "7err4",
  "description": "Single images with MOSS-Image: text to image, image to image and upscaling, with a history of every setting.",
  "kinds": [
    "generate"
  ],
  "family": "any",
  "content": "sfw",
  "license": "GPL-3.0",
  "ui": [
    "image"
  ],
  "nodes": [
    "nodes/ComfyUI-Fumika-Image",
    "nodes/ComfyUI-SeedVR2_VideoUpscaler"
  ],
  "models": [
    {
      "id": "realesrgan_x4",
      "name": "Real-ESRGAN x4plus (upscaler)",
      "file": "RealESRGAN_x4plus.safetensors",
      "dest": "upscale_models",
      "url": "https://huggingface.co/Comfy-Org/Real-ESRGAN_repackaged/resolve/main/RealESRGAN_x4plus.safetensors",
      "size": 66857836,
      "kind": "recommended",
      "note": "fast 4x upscale without redrawing; the MOSS redraw needs no extra model",
      "license": "BSD-3-Clause",
      "license_url": "https://huggingface.co/Comfy-Org/Real-ESRGAN_repackaged"
    },
    {
      "id": "seedvr2_3b",
      "name": "SeedVR2 3B (fp8, upscaler)",
      "file": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "dest": "SEEDVR2",
      "url": "https://huggingface.co/numz/SeedVR2_comfyUI/resolve/main/seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "size": 3391544696,
      "kind": "optional",
      "note": "upscaler that adds real detail (ByteDance SeedVR2); also needs the SeedVR2 VAE",
      "license": "Apache-2.0",
      "license_url": "https://huggingface.co/numz/SeedVR2_comfyUI"
    },
    {
      "id": "seedvr2_7b_sharp",
      "name": "SeedVR2 7B sharp (fp8, best upscaler)",
      "file": "seedvr2_ema_7b_sharp_fp8_e4m3fn_mixed_block35_fp16.safetensors",
      "dest": "SEEDVR2",
      "url": "https://huggingface.co/AInVFX/SeedVR2_comfyUI/resolve/main/seedvr2_ema_7b_sharp_fp8_e4m3fn_mixed_block35_fp16.safetensors",
      "size": 8466296338,
      "kind": "optional",
      "note": "sharper and more detailed than 3B, needs more graphics memory",
      "license": "Apache-2.0",
      "license_url": "https://huggingface.co/AInVFX/SeedVR2_comfyUI"
    },
    {
      "id": "seedvr2_vae",
      "name": "SeedVR2 VAE",
      "file": "ema_vae_fp16.safetensors",
      "dest": "SEEDVR2",
      "url": "https://huggingface.co/numz/SeedVR2_comfyUI/resolve/main/ema_vae_fp16.safetensors",
      "size": 501324814,
      "kind": "optional",
      "note": "belongs to the SeedVR2 upscaler",
      "license": "Apache-2.0",
      "license_url": "https://huggingface.co/numz/SeedVR2_comfyUI"
    }
  ],
  "workflows": {
    "t2i": {
      "file": "workflows/t2i.json",
      "defaults": {
        "unet": "moss_image_base_bf16.safetensors",
        "text_encoder": "qwen3.5_9b_int8_convrot.safetensors",
        "vae": "flux2-vae.safetensors",
        "clip_type": "moss_image",
        "latent_node": "EmptyFlux2LatentImage",
        "turbo_lora": "",
        "loras": "[]",
        "sft_look": "",
        "sft_strength": 1.5,
        "slg": "",
        "steps": 50,
        "cfg": 3.0,
        "sampler": "euler",
        "scheduler": "sgm_uniform",
        "negative": "",
        "count": 1,
        "width": 1024,
        "height": 1024,
        "loader": "split",
        "clip_skip": 0,
        "clip_loras": false
      }
    },
    "i2i": {
      "file": "workflows/i2i.json",
      "defaults": {
        "unet": "moss_image_base_bf16.safetensors",
        "text_encoder": "qwen3.5_9b_int8_convrot.safetensors",
        "vae": "flux2-vae.safetensors",
        "clip_type": "moss_image",
        "latent_node": "EmptyFlux2LatentImage",
        "turbo_lora": "",
        "loras": "[]",
        "sft_look": "",
        "sft_strength": 1.5,
        "slg": "",
        "steps": 50,
        "cfg": 3.0,
        "sampler": "euler",
        "scheduler": "sgm_uniform",
        "negative": "",
        "count": 1,
        "denoise": 0.6,
        "loader": "split",
        "clip_skip": 0,
        "clip_loras": false
      }
    },
    "inpaint": {
      "file": "workflows/inpaint.json",
      "defaults": {
        "unet": "moss_image_base_bf16.safetensors",
        "text_encoder": "qwen3.5_9b_int8_convrot.safetensors",
        "vae": "flux2-vae.safetensors",
        "clip_type": "moss_image",
        "latent_node": "EmptyFlux2LatentImage",
        "turbo_lora": "",
        "loras": "[]",
        "sft_look": "",
        "sft_strength": 1.5,
        "slg": "",
        "steps": 50,
        "cfg": 3.0,
        "sampler": "euler",
        "scheduler": "sgm_uniform",
        "negative": "",
        "count": 1,
        "denoise": 0.75,
        "only_masked": true,
        "padding": 32,
        "target": 1024,
        "mask_blur": 4,
        "loader": "split",
        "clip_skip": 0,
        "clip_loras": false
      }
    },
    "upscale_esrgan": {
      "file": "workflows/upscale_esrgan.json",
      "defaults": {
        "upscaler": "RealESRGAN_x4plus.safetensors",
        "esrgan_factor": 0.5
      }
    },
    "upscale_seedvr2": {
      "file": "workflows/upscale_seedvr2.json",
      "defaults": {
        "dit": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
        "resolution": 2048,
        "max_resolution": 4096,
        "seed": 42
      }
    },
    "upscale_redraw": {
      "file": "workflows/upscale_redraw.json",
      "defaults": {
        "unet": "moss_image_base_bf16.safetensors",
        "text_encoder": "qwen3.5_9b_int8_convrot.safetensors",
        "vae": "flux2-vae.safetensors",
        "clip_type": "moss_image",
        "latent_node": "EmptyFlux2LatentImage",
        "turbo_lora": "",
        "loras": "[]",
        "sft_look": "",
        "sft_strength": 1.5,
        "slg": "",
        "steps": 50,
        "cfg": 3.0,
        "sampler": "euler",
        "scheduler": "sgm_uniform",
        "negative": "",
        "count": 1,
        "scale": 1.5,
        "denoise": 0.3,
        "prompt": "",
        "loader": "split",
        "clip_skip": 0,
        "clip_loras": false
      }
    }
  },
  "python": [
    "omegaconf>=2.3.0",
    "diffusers>=0.33.1",
    "peft>=0.17.0",
    "rotary_embedding_torch>=0.5.3",
    "gguf",
    "matplotlib"
  ],
  "requires_one": [
    "family-moss",
    "family-anima",
    "family-sdxl",
    "family-anima38"
  ]
}
